VITE_API_BASE_URL=https://spoorthischool.genzix.space

# Default school when hostname has no tenant subdomain (local / preview)
# VITE_DEFAULT_SCHOOL=spoorthi

# Optional GenCampus API override (defaults to https://school-dev.genzix.space)
# VITE_GENCAMPUS_API_BASE_URL=https://school-dev.genzix.space

# When true, merge GET {api}/public/schools/{slug}/ over static registry
# VITE_FETCH_SCHOOL_BRANDING=false

# Module toggles (true = show in admin, false = hide nav + block route)
# Per-school modules in src/schools/registry.js override these when set.
VITE_MODULE_UPCOMING_EXAMS=true
